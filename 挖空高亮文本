Sub ToggleClozeHighlight()
    Dim rng As Range
    Dim clozeColor As Long
    Dim foundWhite As Boolean
    
    clozeColor = RGB(255, 255, 255)
    
    ' ==========================================
    ' 判断：文档中是否存在“白色字”
    ' （只要存在，就认为是挖空状态）
    ' ==========================================
    foundWhite = False
    Set rng = ActiveDocument.Range
    
    With rng.Find
        .ClearFormatting
        .Text = ""
        .Format = True
        .Font.Color = clozeColor
        If .Execute Then foundWhite = True
    End With
    
    Set rng = ActiveDocument.Range
    
    If foundWhite Then
        ' ==========================================
        ' 【恢复】白色字 → 黑色 + 打开高亮
        ' ==========================================
        With rng.Find
            .ClearFormatting
            .Text = ""
            .Format = True
            .Font.Color = clozeColor
            
            .Replacement.Text = ""
            .Replacement.ClearFormatting
            .Replacement.Font.Color = wdColorAutomatic
            .Replacement.Highlight = True
            
            .Wrap = wdFindContinue
            .Execute Replace:=wdReplaceAll
        End With
        
        MsgBox "已显示全部内容", vbInformation
        
    Else
        ' ==========================================
        ' 【挖空】高亮文字 → 白色 + 关闭高亮
        ' ==========================================
        With rng.Find
            .ClearFormatting
            .Text = ""
            .Format = True
            .Highlight = True
            
            .Replacement.Text = ""
            .Replacement.ClearFormatting
            .Replacement.Font.Color = clozeColor
            .Replacement.Highlight = False
            
            .Wrap = wdFindContinue
            .Execute Replace:=wdReplaceAll
        End With
        
        MsgBox "已挖空高亮内容", vbInformation
    End If
End Sub
